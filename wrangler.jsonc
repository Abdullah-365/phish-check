{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phish-check",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API routes reach the Worker code; everything else is a static file.
    "run_worker_first": ["/api/*"]
  },
  // Off on purpose: Workers Logs would store each request's details, including the visitor's IP
  // address. `wrangler tail` still streams live logs for debugging without keeping them.
  "observability": {
    "enabled": false
  },
  // Served on its own subdomain. On deploy, Cloudflare creates this one DNS record and its
  // certificate; the rest of abdullah1.dev's records are left alone.
  "routes": [{ "pattern": "phish.abdullah1.dev", "custom_domain": true }]
}
